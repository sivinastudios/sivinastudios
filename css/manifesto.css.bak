:root{--knowing:0;--ink:#28242a;--violet:#6f3b82;--paper:rgba(248,244,237,.92)}*{box-sizing:border-box}html{scroll-behavior:smooth;background:#171316}body{margin:0;color:var(--ink);font-family:Georgia,'Times New Roman',serif;background:#171316;overflow-x:hidden}.world{position:fixed;inset:0;z-index:-3;background:#171316;overflow:hidden}.state{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;pointer-events:none}.state-reality{z-index:1}.state-sketch{z-index:2;opacity:clamp(0,calc((var(--knowing) - .76)*8),1);mask-image:radial-gradient(ellipse 92% 82% at 68% 52%,#000 0 54%,transparent 74%);filter:contrast(.96)}.state-watercolor{z-index:3;opacity:clamp(0,calc((var(--knowing) - .89)*10),1);mask-image:radial-gradient(ellipse 86% 78% at 62% 52%,#000 0 48%,transparent 75%)}.room-light{position:absolute;z-index:4;inset:0;background:radial-gradient(circle at 51% 48%,rgba(255,248,238,.08),transparent 34%),linear-gradient(90deg,rgba(18,12,15,.18),transparent 24% 78%,rgba(18,12,15,.2));animation:roomBreath 12s ease-in-out infinite alternate}.grain{position:absolute;z-index:5;inset:-80px;opacity:.06;mix-blend-mode:multiply;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");animation:grain .6s steps(2) infinite}.dust{position:absolute;z-index:6;inset:0;background:radial-gradient(circle at 20% 28%,rgba(255,255,255,.55) 0 1px,transparent 1.5px),radial-gradient(circle at 76% 61%,rgba(255,255,255,.4) 0 1px,transparent 1.5px);background-size:270px 310px,390px 360px;opacity:.23;animation:dust 23s linear infinite}.masthead{position:fixed;z-index:20;top:0;left:0;width:100%;height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(22px,5vw,78px);font-family:Arial,sans-serif;font-size:9px;letter-spacing:.52em;color:#29242b}.masthead a{color:inherit;text-decoration:none}.wordmark span{font-size:15px;margin-right:10px}.masthead p{margin-left:auto;margin-right:36px}.masthead b{font-weight:400}.masthead button{border:0;background:transparent;font:inherit;letter-spacing:.25em;color:inherit;cursor:pointer}.chapters{position:fixed;z-index:20;left:clamp(18px,4vw,68px);top:27vh;display:grid;gap:26px;padding-left:22px;font-family:Arial,sans-serif;font-size:9px;letter-spacing:.08em}.chapters a{color:#4d4850;text-decoration:none;opacity:.7;transition:.5s}.chapters a b{font-weight:400;margin-right:10px}.chapters a.is-active{opacity:1;color:var(--violet);transform:translateX(3px)}.chapter-line{position:absolute;left:0;top:-9px;height:calc(100% + 18px);width:1px;background:rgba(50,45,52,.2)}.chapter-line i{display:block;width:3px;height:3px;margin-left:-1px;border-radius:50%;background:var(--violet);transform:translateY(calc(var(--knowing)*130px));box-shadow:0 0 9px var(--violet);transition:transform .8s ease}.studio-rail{position:fixed;z-index:20;left:clamp(22px,4vw,70px);bottom:7vh;writing-mode:vertical-rl;transform:rotate(180deg);font:8px Arial,sans-serif;letter-spacing:.48em}.progress{position:fixed;z-index:20;right:clamp(20px,4vw,60px);bottom:6vh;display:flex;align-items:center;gap:10px;font:8px Arial,sans-serif;letter-spacing:.22em}.progress i{width:4px;height:4px;border-radius:50%;background:var(--violet);box-shadow:0 0 10px #c280dc}main{width:min(700px,54vw);margin-left:31.5vw;padding:18vh 0 36vh}.chapter{min-height:100vh;margin-bottom:24vh;padding:clamp(30px,6vw,82px);background:var(--paper);box-shadow:0 20px 80px rgba(31,20,30,.12);backdrop-filter:blur(5px);opacity:.38;transform:translateY(20px);transition:opacity 1.1s ease,transform 1.1s ease}.chapter.is-visible{opacity:1;transform:none}.eyebrow{font:9px Arial,sans-serif;letter-spacing:.34em;color:#685f68;margin:0 0 42px}.chapter h1,.chapter h2{font-weight:400;letter-spacing:.05em;line-height:1.18;margin:0 0 50px;font-size:clamp(34px,4.1vw,59px)}.chapter h2{font-size:clamp(29px,3.5vw,50px)}em{font-weight:400;font-style:normal;color:var(--violet);text-shadow:0 0 14px rgba(123,61,143,.22);animation:letterBreath 5s ease-in-out infinite}.lead{font-size:clamp(18px,1.55vw,24px);line-height:1.48;margin:0 0 68px}.lead p{margin:.12em 0}.columns{display:grid;grid-template-columns:1fr 1fr;gap:44px;font-size:14px;line-height:1.85}.closing{margin-top:70px;font-size:clamp(19px,2vw,27px);line-height:1.6}.continue{display:block;margin-top:62px;font:8px Arial,sans-serif;letter-spacing:.25em}.continue i{font-size:14px;font-style:normal}.prose{font-size:clamp(15px,1.25vw,18px);line-height:1.8}.prose p{margin:0 0 1.25em}.prose strong{font-weight:400;color:var(--violet);font-size:1.12em}.farewell{text-align:center;margin-top:80px;padding-top:60px;border-top:1px solid rgba(70,57,72,.2)}.farewell h2{margin-bottom:30px}.founders-link{display:block;margin:84px auto 0;width:max-content;max-width:100%;padding:14px 0;border-bottom:1px solid var(--violet);color:var(--ink);text-decoration:none;font:9px Arial,sans-serif;letter-spacing:.25em}.founders-link span{color:var(--violet);font-size:15px;margin-left:12px}.touch-hint{display:none}@keyframes roomBreath{to{filter:brightness(1.04);transform:scale(1.008)}}@keyframes letterBreath{50%{color:#8f4da6;text-shadow:0 0 18px rgba(151,72,180,.38)}}@keyframes grain{0%{transform:translate(0)}25%{transform:translate(3%,2%)}50%{transform:translate(-2%,1%)}75%{transform:translate(1%,-3%)}}@keyframes dust{to{background-position:80px 140px,-100px 190px}}
@media(max-width:900px){.masthead{height:60px;padding:0 18px}.masthead p{margin-right:0}.masthead button{display:none}.chapters,.studio-rail{display:none}main{width:auto;margin:0;padding:13vh 14px 24vh}.chapter{width:min(94vw,660px);margin:0 auto 20vh;padding:44px clamp(24px,7vw,58px);background:rgba(250,246,240,.91)}.columns{grid-template-columns:1fr;gap:8px}.progress{right:14px;bottom:16px;padding:8px;background:rgba(248,244,237,.7)}.state{object-position:center}.touch-hint{display:block;position:fixed;z-index:20;bottom:18px;left:18px;font:8px Arial,sans-serif;letter-spacing:.22em;color:#29242b}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition-duration:.01ms!important}.grain,.dust{display:none}}
